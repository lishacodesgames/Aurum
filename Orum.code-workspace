{
   "folders": [
      {
         "path": "."
      }
   ],

   "settings": {
      "workbench.colorTheme": "Bearded Theme Oceanic",
      "workbench.iconTheme": "material-icon-theme",

      "cmake.useCMakePresets": "always",
      "cmake.debugConfig": {
         "args": [
            "gold.or"
         ],
         "cwd": "${workspaceFolder}"
      },
   },

   "extensions": {
      "recommendations": [
         "beardedbear.beardedtheme",
         "pkief.material-icon-theme",
         "13xforever.language-x86-64-assembly",
      ]
   },

   "launch": {
      "version": "0.2.0",
      "configurations": [
         {
            "name": "Debug (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["gold.or"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "console": "internalConsole",
            "expressions": "native",
            "initCommands": [
               "settings set target.language c++20" // lldb doesn't support c++23
            ],
         }
      ]
   },

   "tasks": {
      "version": "2.0.0",
      "tasks": [
         {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": ["all"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
               "kind": "build",
               "isDefault": true
            },
            "problemMatcher": [],
         }
      ]
   }
}
