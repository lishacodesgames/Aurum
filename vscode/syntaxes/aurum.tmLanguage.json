{
   "scopeName": "source.aurum",

   "patterns": [
      { "include": "#blockComments" },
      { "include": "#comments" },
      { "include": "#keywords" },
      { "include": "#numbers" },
      { "include": "#operators" },
      { "include": "#identifiers" }
   ],

   "repository": {
      "blockComments": {
         "begin": "\\$~",
         "end": "~\\$",
         "name": "comment.block.aurum"
      },

      "comments": {
         "match": "\\$\\$.*$",
         "name": "comment.line.double-dollar.aurum"
      },

      "keywords": {
         "match": "\\b(bar|mint|exit)\\b",
         "name": "keyword.control.aurum"
      },

      "numbers": {
         "match": "\\b[0-9]+\\b",
         "name": "constant.numeric.aurum"
      },

      "operators": {
         "match": "\\+|-|\\*|/|%|\\^",
         "name": "keyword.operator.aurum"
      },

      "identifiers": {
         "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
         "name": "variable.other.aurum"
      }
   }
}